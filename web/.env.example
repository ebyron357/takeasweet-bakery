# Public canonical URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines remain blocked unless this is explicitly enabled with a
# non-local HTTPS site URL after production content and policies are approved.
SEARCH_INDEXING_ENABLED=false

# Add provider credentials only after the provider is confirmed.
# Never commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Checkout remains unavailable unless this explicit launch gate is enabled and
# Stripe, webhook verification, database persistence, and the privacy contact
# are all configured.
PAYMENTS_ENABLED=false

# Custom-order requests are stored only after the database is configured and
# this separate launch gate is enabled.
DATABASE_URL=
CUSTOM_ORDER_REQUESTS_ENABLED=false

# Required before customer information collection is launched.
PRIVACY_CONTACT_EMAIL=
