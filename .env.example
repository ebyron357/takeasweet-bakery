# TakeASweet Bakery — environment variables
#
# Copy to `.env` for local development. Never commit real values.
# On Manus hosting, the platform injects the Manus values (marked [Manus]);
# set the rest in the project's secrets/environment settings.
# VITE_* values are read at build time — rebuild after changing them.

# --- Server ---------------------------------------------------------------
# MySQL connection string. Required: without it the site runs in fail-closed
# mode (review mode on, payments off, empty sections hidden).
DATABASE_URL=mysql://user:password@host:3306/database
# Long random string used to sign login session cookies. Required.
JWT_SECRET=
# Port the server listens on (default 3000).
PORT=3000
# Final public https:// origin, e.g. https://www.example.com. Search engines are
# allowed to index the site only when this is set AND review mode is off.
PUBLIC_SITE_URL=

# --- Login and admin access [Manus] ----------------------------------------
# Admin sign-in uses Manus OAuth. The account whose open ID matches
# OWNER_OPEN_ID becomes an admin on first sign-in.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# --- Manus platform services [Manus] ---------------------------------------
# Serve uploaded images under /manus-storage/… and send owner notifications for
# new orders, custom requests, and messages.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Stripe (online payments) ----------------------------------------------
# Secret key from the bakery's own Stripe account. sk_test_… = test mode
# (Admin shows "Stripe test keys"); sk_live_… = real charges.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook,
# subscribed to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired,
# checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# --- Analytics (optional) --------------------------------------------------
# Umami analytics. The script is added only when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
